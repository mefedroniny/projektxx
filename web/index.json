{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .pp { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); color: var(--color-fg); font-variant-numeric: tabular-nums; }\n  .pp p { margin: 0; }\n  .pp-head { display: grid; gap: var(--cds-gap-xs); }\n  .pp-head h1 { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); text-wrap: balance; }\n  .pp-lede { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 72ch; }\n  .pp .pp-lede b { color: var(--color-fg); font-weight: 600; }\n\n  .pp-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--cds-gap-md); }\n  .pp-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n  .pp-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; display: grid; gap: var(--cds-gap-sm); align-content: start; }\n  .pp-card h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); text-wrap: balance; }\n  .pp-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-cardhead { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--cds-gap-sm); }\n  .pp-cardhead > div { display: grid; gap: var(--cds-gap-xs); min-width: 0; }\n\n  .pp-tile-label { display: flex; align-items: center; gap: var(--cds-gap-xs); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: calc(var(--cds-font-size-title) * 1.3); line-height: 1.1; }\n  .pp-unit { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-body); color: var(--color-fg-muted); }\n  .pp-tile-sub { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); line-height: 1.5; }\n  .pp .pp-tile-sub b { font-weight: 600; color: var(--color-fg); }\n  .pp .pp-up { color: var(--color-bad); }\n  .pp .pp-down { color: var(--color-ok); }\n\n  .pp-sw { display: inline-block; width: 0.625rem; height: 0.625rem; border-radius: 2px; flex: none; vertical-align: baseline; }\n  .pp-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); margin: 0; padding: 0; list-style: none; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-legend li { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n\n  .pp-seg { display: inline-flex; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; flex: none; }\n  .pp-seg button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); background: transparent; color: var(--color-fg-muted); border: 0; cursor: pointer; }\n  .pp-seg button + button { border-left: 1px solid var(--color-border-line); }\n  .pp-seg button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); }\n  .pp-seg button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: -2px; }\n\n  .pp-chart { position: relative; min-width: 0; }\n  .pp-chart-main { min-height: 340px; }\n  .pp-chart-spread { min-height: 200px; }\n  .pp-chart-nb { min-height: 220px; }\n  .pp-chart svg { display: block; overflow: visible; }\n  .pp-tick { fill: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-grid { stroke: var(--cds-chart-grid); stroke-width: 1; }\n  .pp-axis { stroke: var(--cds-chart-axis); stroke-width: 1; }\n  .pp-ref { stroke: var(--cds-chart-reference); stroke-width: 1; stroke-dasharray: 3 3; }\n  .pp-line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n  .pp-spread-line { fill: none; stroke: var(--color-fg-muted); stroke-width: 1.25; stroke-linejoin: round; }\n  .pp-rule { stroke: var(--cds-chart-axis); stroke-width: 1; }\n  .pp-ev-dot { fill: var(--color-panel); stroke: var(--cds-chart-reference); stroke-width: 1.25; }\n  .pp-ev-num { fill: var(--color-fg); font-size: 10px; font-weight: 600; }\n  .pp-end-v { font-size: var(--cds-font-size-caption); font-weight: 600; }\n  .pp-end-n { fill: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-cat { fill: var(--color-fg); font-size: var(--cds-font-size-caption); }\n  .pp-cat-cz { font-weight: 600; }\n  .pp-val { fill: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-band { fill: var(--cds-chart-grid); }\n\n  .pp-tip { position: absolute; z-index: 2; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; display: grid; gap: 2px; }\n  .pp-tip-h { color: var(--cds-text-secondary); }\n  .pp-tip-r { display: flex; align-items: center; gap: var(--cds-gap-xs); }\n  .pp-tip-r b { margin-left: auto; padding-left: var(--cds-pad-sm); font-weight: 600; }\n\n  .pp-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pp-fail-dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n\n  .pp-events { display: grid; gap: var(--cds-gap-xs); margin: 0; padding: 0; list-style: none; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pp-events li { display: grid; grid-template-columns: auto auto 1fr; align-items: baseline; gap: var(--cds-gap-sm); }\n  .pp-events time { color: var(--color-fg); white-space: nowrap; }\n  .pp-ev-n { display: inline-grid; place-items: center; width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1.25px solid var(--cds-chart-reference); color: var(--color-fg); font-size: 10px; font-weight: 600; }\n\n  .pp-tablewrap { overflow-x: auto; min-width: 0; }\n  .pp-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); }\n  .pp-table th, .pp-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); text-align: right; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .pp-table thead th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); vertical-align: bottom; }\n  .pp-table th:first-child, .pp-table td:first-child { text-align: left; padding-left: 0; }\n  .pp-table th:last-child, .pp-table td:last-child { padding-right: 0; }\n  .pp-table tbody th { font-weight: 600; }\n  .pp-table tbody th .pp-sw { margin-right: var(--cds-gap-xs); }\n  .pp-table tbody tr:last-child > * { border-bottom: 0; }\n\n  .pp-field { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-sm); font-size: var(--cds-font-size-body); }\n  .pp-field input { font: inherit; width: 5.5rem; padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); font-variant-numeric: tabular-nums; }\n  .pp-field input:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 1px; }\n\n  .pp-foot { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); line-height: 1.6; max-width: 90ch; }\n  .pp-foot a { color: inherit; }\n\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"pp\">\n  <header class=\"pp-head\">\n    <h1 id=\"nadpis\">Ceny pohonných hmot v ČR</h1>\n    <p class=\"pp-lede\">Celostátní průměr za týden od <b class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"tyden\" data-row=\"0\">—</b>. Proti stejnému týdnu před rokem je nafta <b class=\"dash-skeleton\" data-draw=\"zmena\" data-tone=\"off\" data-source=\"souhrn\" data-field=\"nafta_zmena_rok\" data-row=\"0\">—</b> Kč/l a Natural 95 <b class=\"dash-skeleton\" data-draw=\"zmena\" data-tone=\"off\" data-source=\"souhrn\" data-field=\"natural95_zmena_rok\" data-row=\"0\">—</b> Kč/l.</p>\n  </header>\n\n  <section class=\"pp-tiles\" id=\"prehled\" aria-label=\"Aktuální ceny\">\n    <div class=\"pp-card\">\n      <p class=\"pp-tile-label\"><span class=\"pp-sw\" data-i=\"0\"></span>Natural 95</p>\n      <p class=\"pp-big\"><span class=\"dash-skeleton\" data-draw=\"cislo\" data-source=\"souhrn\" data-field=\"natural95\" data-row=\"0\">—</span> <span class=\"pp-unit\">Kč/l</span></p>\n      <p class=\"pp-tile-sub\"><b class=\"dash-skeleton\" data-draw=\"zmena\" data-source=\"souhrn\" data-field=\"natural95_tyden\" data-row=\"0\">—</b> Kč za týden · <b class=\"dash-skeleton\" data-draw=\"zmena\" data-source=\"souhrn\" data-field=\"natural95_zmena_rok\" data-row=\"0\">—</b> Kč za rok</p>\n    </div>\n    <div class=\"pp-card\">\n      <p class=\"pp-tile-label\"><span class=\"pp-sw\" data-i=\"1\"></span>Nafta</p>\n      <p class=\"pp-big\"><span class=\"dash-skeleton\" data-draw=\"cislo\" data-source=\"souhrn\" data-field=\"nafta\" data-row=\"0\">—</span> <span class=\"pp-unit\">Kč/l</span></p>\n      <p class=\"pp-tile-sub\"><b class=\"dash-skeleton\" data-draw=\"zmena\" data-source=\"souhrn\" data-field=\"nafta_tyden\" data-row=\"0\">—</b> Kč za týden · <b class=\"dash-skeleton\" data-draw=\"zmena\" data-source=\"souhrn\" data-field=\"nafta_zmena_rok\" data-row=\"0\">—</b> Kč za rok</p>\n    </div>\n    <div class=\"pp-card\">\n      <p class=\"pp-tile-label\">Nafta proti benzínu</p>\n      <p class=\"pp-big\"><span class=\"dash-skeleton\" data-draw=\"zmena\" data-tone=\"off\" data-source=\"souhrn\" data-field=\"rozdil\" data-row=\"0\">—</span> <span class=\"pp-unit\">Kč/l</span></p>\n      <p class=\"pp-tile-sub\">Rozdíl nafta minus Natural 95. Kladné číslo znamená, že je dražší nafta.</p>\n    </div>\n    <div class=\"pp-card\">\n      <p class=\"pp-tile-label\">Nejdražší nafta za sledované období</p>\n      <p class=\"pp-big\"><span class=\"dash-skeleton\" data-draw=\"cislo\" data-source=\"souhrn\" data-field=\"nafta_max\" data-row=\"0\">—</span> <span class=\"pp-unit\">Kč/l</span></p>\n      <p class=\"pp-tile-sub\">Týden od <b class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"nafta_max_tyden\" data-row=\"0\">—</b>. Natural 95 nejvýš <b class=\"dash-skeleton\" data-draw=\"cislo\" data-source=\"souhrn\" data-field=\"natural95_max\" data-row=\"0\">—</b> Kč/l (<b class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"natural95_max_tyden\" data-row=\"0\">—</b>).</p>\n    </div>\n  </section>\n\n  <section class=\"pp-card\" id=\"vyvoj\">\n    <div class=\"pp-cardhead\">\n      <div>\n        <h2 id=\"vyvoj-nadpis\">Vývoj cen</h2>\n        <p class=\"pp-note\">Kč za litr, týdenní celostátní průměr včetně DPH a spotřební daně. Čísla v kroužcích odkazují na události pod grafem.</p>\n      </div>\n      <div class=\"pp-seg\" role=\"group\" aria-label=\"Období\">\n        <button type=\"button\" data-range=\"1\" aria-pressed=\"false\">1 rok</button>\n        <button type=\"button\" data-range=\"2\" aria-pressed=\"false\">2 roky</button>\n        <button type=\"button\" data-range=\"vse\" aria-pressed=\"true\">Vše</button>\n      </div>\n    </div>\n    <div class=\"pp-chart pp-chart-main dash-skeleton\" id=\"graf-vyvoj\" data-draw=\"graf\" data-source=\"ceny udalosti\"></div>\n    <ol class=\"pp-events\" id=\"udalosti\" data-draw=\"udalosti\" data-source=\"udalosti\"></ol>\n  </section>\n\n  <div class=\"pp-row\">\n    <section class=\"pp-card\" id=\"rozdil\">\n      <h2 id=\"rozdil-nadpis\">Je dražší nafta, nebo benzín?</h2>\n      <ul class=\"pp-legend\">\n        <li><span class=\"pp-sw\" data-i=\"1\"></span>Nad nulou: dražší nafta</li>\n        <li><span class=\"pp-sw\" data-i=\"0\"></span>Pod nulou: dražší Natural 95</li>\n      </ul>\n      <p class=\"pp-note\">Rozdíl v Kč za litr, stejné období jako graf výše.</p>\n      <div class=\"pp-chart pp-chart-spread dash-skeleton\" id=\"graf-rozdil\" data-draw=\"rozdil\" data-source=\"rozdil\"></div>\n    </section>\n\n    <section class=\"pp-card\" id=\"sousede\">\n      <h2 id=\"sousede-nadpis\">Kolik stojí palivo u sousedů</h2>\n      <ul class=\"pp-legend\">\n        <li><span class=\"pp-sw\" data-i=\"0\"></span>Natural 95</li>\n        <li><span class=\"pp-sw\" data-i=\"1\"></span>Nafta</li>\n      </ul>\n      <p class=\"pp-note\">Kč za litr, týden od <span class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"sousede\" data-field=\"tyden\" data-row=\"0\">—</span>, přepočteno kurzem ECB. Seřazeno podle ceny nafty.</p>\n      <div class=\"pp-chart pp-chart-nb dash-skeleton\" id=\"graf-sousede\" data-draw=\"sousede\" data-source=\"sousede\"></div>\n    </section>\n  </div>\n\n  <div class=\"pp-row\">\n    <section class=\"pp-card\" id=\"roky\">\n      <h2 id=\"roky-nadpis\">Průměry po letech</h2>\n      <p class=\"pp-note\">Kč za litr. Krajní roky nejsou úplné: data začínají týdnem od <span class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"od\" data-row=\"0\">—</span> a končí týdnem od <span class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"do\" data-row=\"0\">—</span>.</p>\n      <div class=\"pp-tablewrap\">\n        <table class=\"pp-table\" data-source=\"roky\" data-row-key=\"rok\">\n          <thead>\n            <tr>\n              <th data-field=\"rok\">Rok</th>\n              <th data-field=\"natural95_prumer\">Natural 95 průměr</th>\n              <th data-field=\"natural95_max\">Natural 95 max</th>\n              <th data-field=\"nafta_prumer\">Nafta průměr</th>\n              <th data-field=\"nafta_max\">Nafta max</th>\n              <th data-field=\"tydnu\">Týdnů</th>\n            </tr>\n          </thead>\n          <tbody data-draw=\"roky\"></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"pp-card\" id=\"nadrz\">\n      <h2 id=\"nadrz-nadpis\">Plná nádrž</h2>\n      <p class=\"pp-note\">Kolik zaplatíte za natankování teď a kolik by to stálo v týdnu od <span class=\"dash-skeleton\" data-draw=\"datum\" data-source=\"souhrn\" data-field=\"tyden_rok\" data-row=\"0\">—</span>.</p>\n      <label class=\"pp-field\" for=\"pp-litry\">Objem nádrže <input id=\"pp-litry\" type=\"number\" inputmode=\"numeric\" min=\"1\" max=\"200\" step=\"1\" value=\"50\"> litrů</label>\n      <div class=\"pp-tablewrap\">\n        <table class=\"pp-table\">\n          <thead>\n            <tr><th>Palivo</th><th>Teď</th><th>Před rokem</th><th>Rozdíl</th></tr>\n          </thead>\n          <tbody data-draw=\"nadrz\" data-source=\"souhrn\"></tbody>\n        </table>\n      </div>\n    </section>\n  </div>\n\n  <footer class=\"pp-foot\" id=\"zdroje\">\n    <p>Ceny: Evropská komise, Weekly Oil Bulletin, převzato z <a href=\"https://www.fuel-prices.eu/Czechia/cs/\">fuel-prices.eu</a> (CC BY 4.0). Bulletin uvádí ceny v eurech, na koruny jsou přepočteny denním kurzem ECB z pondělí daného týdne. Události: ČSÚ, ČTK a Cenový věstník Ministerstva financí. Bulletin měří jinou metodikou než ČSÚ nebo CCS, takže se jejich čísla mohou o desítky haléřů lišit.</p>\n  </footer>\n</div>\n\n<script>\n(() => {\n  const nf = new Intl.NumberFormat('cs-CZ', {minimumFractionDigits: 2, maximumFractionDigits: 2});\n  const sf = new Intl.NumberFormat('cs-CZ', {minimumFractionDigits: 2, maximumFractionDigits: 2, signDisplay: 'exceptZero'});\n  const kc = new Intl.NumberFormat('cs-CZ', {maximumFractionDigits: 0});\n  const skc = new Intl.NumberFormat('cs-CZ', {maximumFractionDigits: 0, signDisplay: 'exceptZero'});\n  const osaFmt = new Intl.NumberFormat('cs-CZ', {maximumFractionDigits: 1});\n  const osaZnFmt = new Intl.NumberFormat('cs-CZ', {maximumFractionDigits: 1, signDisplay: 'exceptZero'});\n  const den = (s) => { const [y, m, d] = String(s).slice(0, 10).split('-'); return `${+d}. ${+m}. ${y}`; };\n  const cz = d3.timeFormatLocale({\n    dateTime: '%A %-d. %B %Y %X', date: '%-d. %-m. %Y', time: '%H:%M:%S', periods: ['', ''],\n    days: ['neděle', 'pondělí', 'úterý', 'středa', 'čtvrtek', 'pátek', 'sobota'],\n    shortDays: ['ne', 'po', 'út', 'st', 'čt', 'pá', 'so'],\n    months: ['leden', 'únor', 'březen', 'duben', 'květen', 'červen', 'červenec', 'srpen', 'září', 'říjen', 'listopad', 'prosinec'],\n    shortMonths: ['led', 'úno', 'bře', 'dub', 'kvě', 'čvn', 'čvc', 'srp', 'zář', 'říj', 'lis', 'pro'],\n  });\n  const SVGNS = 'http://www.w3.org/2000/svg';\n  let obdobi = 'vse';\n\n  dash.calc('souhrn', {\n    inputs: ['ceny'],\n    title: 'Souhrn posledního týdne',\n    description: 'Poslední týden, změna proti předchozímu týdnu a proti týdnu o rok dřív, rozdíl nafta minus Natural 95 a nejvyšší ceny za celé období.',\n    fn: (ceny) => {\n      const r = ceny.map((d) => ({tyden: d.tyden, n95: +d.natural95, naf: +d.nafta})).sort((a, b) => (a.tyden < b.tyden ? -1 : 1));\n      const r2 = (x) => Math.round(x * 100) / 100;\n      const ted = r[r.length - 1], minule = r[r.length - 2];\n      const cil = Date.parse(ted.tyden) - 364 * 864e5;\n      const loni = r.reduce((a, d) => (Math.abs(Date.parse(d.tyden) - cil) < Math.abs(Date.parse(a.tyden) - cil) ? d : a));\n      const maxNafta = r.reduce((a, d) => (d.naf > a.naf ? d : a));\n      const maxN95 = r.reduce((a, d) => (d.n95 > a.n95 ? d : a));\n      return [{\n        tyden: ted.tyden, natural95: ted.n95, nafta: ted.naf,\n        natural95_tyden: r2(ted.n95 - minule.n95), nafta_tyden: r2(ted.naf - minule.naf),\n        tyden_rok: loni.tyden, natural95_rok: loni.n95, nafta_rok: loni.naf,\n        natural95_zmena_rok: r2(ted.n95 - loni.n95), nafta_zmena_rok: r2(ted.naf - loni.naf),\n        rozdil: r2(ted.naf - ted.n95),\n        nafta_max: maxNafta.naf, nafta_max_tyden: maxNafta.tyden,\n        natural95_max: maxN95.n95, natural95_max_tyden: maxN95.tyden,\n        od: r[0].tyden, do: ted.tyden,\n      }];\n    },\n  });\n\n  dash.calc('rozdil', {\n    inputs: ['ceny'],\n    title: 'Rozdíl nafta minus benzín',\n    description: 'Pro každý týden cena nafty minus cena Natural 95 v Kč za litr.',\n    fn: (ceny) => ceny.map((d) => ({tyden: d.tyden, rozdil: Math.round((d.nafta - d.natural95) * 100) / 100})),\n  });\n\n  dash.calc('roky', {\n    inputs: ['ceny'],\n    title: 'Průměry po letech',\n    description: 'Průměr a maximum týdenních cen za každý kalendářní rok a počet týdnů s daty.',\n    fn: (ceny) => {\n      const r2 = (x) => Math.round(x * 100) / 100;\n      const roky = {};\n      ceny.forEach((d) => { (roky[d.tyden.slice(0, 4)] ||= []).push(d); });\n      return Object.entries(roky).map(([rok, t]) => ({\n        rok,\n        natural95_prumer: r2(t.reduce((s, d) => s + +d.natural95, 0) / t.length),\n        natural95_max: Math.max(...t.map((d) => +d.natural95)),\n        nafta_prumer: r2(t.reduce((s, d) => s + +d.nafta, 0) / t.length),\n        nafta_max: Math.max(...t.map((d) => +d.nafta)),\n        tydnu: t.length,\n      }));\n    },\n  });\n\n  // Swatches and controls outside drawings: only style and aria.\n  document.querySelectorAll('.pp-sw[data-i]').forEach((s) => { s.style.background = dash.colors[+s.dataset.i]; });\n  document.querySelectorAll('.pp-seg button').forEach((b) => b.addEventListener('click', () => {\n    obdobi = b.dataset.range;\n    document.querySelectorAll('.pp-seg button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));\n    dash.draw('graf');\n    dash.draw('rozdil');\n  }));\n  document.querySelectorAll('#pp-litry').forEach((i) => i.addEventListener('input', () => dash.draw('nadrz')));\n\n  const radek = (id) => {\n    const g = dash.data(id);\n    return g.status === 'ok' && g.data && g.data[0] ? g.data[0] : null;\n  };\n  const textovy = (format, tonovat) => (el) => {\n    const id = el.dataset.source;\n    const r = radek(id);\n    const v = r ? r[el.dataset.field] : null;\n    el.classList.toggle('dash-skeleton', dash.data(id).status === 'loading');\n    el.textContent = v == null || v === '' ? '—' : format(v);\n    const barvit = tonovat && el.dataset.tone !== 'off' && v != null;\n    el.classList.toggle('pp-up', barvit && v > 0);\n    el.classList.toggle('pp-down', barvit && v < 0);\n  };\n  dash.draw('cislo', textovy((v) => nf.format(v), false));\n  dash.draw('zmena', textovy((v) => sf.format(v), true));\n  dash.draw('datum', textovy((v) => den(v), false));\n\n  // Empties a chart box; returns true when there is nothing to draw yet.\n  function stav(el, ...ids) {\n    el.replaceChildren();\n    const st = ids.map((id) => dash.data(id).status);\n    if (st.every((s) => s === 'ok')) { el.classList.remove('dash-skeleton'); return false; }\n    if (st.some((s) => s === 'loading')) { el.classList.add('dash-skeleton'); return true; }\n    el.classList.remove('dash-skeleton');\n    const p = document.createElement('p');\n    p.className = 'pp-fail';\n    const dot = document.createElement('span');\n    dot.className = 'pp-fail-dot';\n    p.append(dot, 'Nepodařilo se načíst');\n    el.append(p);\n    return true;\n  }\n\n  const ceny = () => dash.data('ceny').data\n    .map((d) => ({date: new Date(d.tyden), tyden: d.tyden, n95: +d.natural95, naf: +d.nafta}))\n    .sort((a, b) => a.date - b.date);\n  const udalosti = () => {\n    const g = dash.data('udalosti');\n    if (g.status !== 'ok') return [];\n    return g.data.map((d) => ({date: new Date(d.datum), datum: d.datum, text: d.udalost}))\n      .sort((a, b) => a.date - b.date).map((d, i) => ({...d, n: i + 1}));\n  };\n  const vObdobi = (rows) => {\n    if (obdobi === 'vse' || !rows.length) return rows;\n    const od = d3.utcYear.offset(rows[rows.length - 1].date, -(+obdobi));\n    return rows.filter((d) => d.date >= od);\n  };\n\n  function svgFor(el, W, H, label) {\n    return d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`)\n      .attr('role', 'img').attr('aria-label', label);\n  }\n  function sirka(svg, cls, texty) {\n    const g = svg.append('g');\n    const w = Math.max(0, ...texty.map((t) => g.append('text').attr('class', cls).text(t).node().getComputedTextLength()));\n    g.remove();\n    return w;\n  }\n  function tipPopis(tip, nadpis, radky) {\n    tip.replaceChildren();\n    const h = document.createElement('div');\n    h.className = 'pp-tip-h';\n    h.textContent = nadpis;\n    tip.append(h);\n    radky.forEach(([barva, nazev, hodnota]) => {\n      const r = document.createElement('div');\n      r.className = 'pp-tip-r';\n      if (barva) {\n        const s = document.createElement('span');\n        s.className = 'pp-sw';\n        s.style.background = barva;\n        r.append(s);\n      }\n      const n = document.createElement('span');\n      n.textContent = nazev;\n      const v = document.createElement('b');\n      v.textContent = hodnota;\n      r.append(n, v);\n      tip.append(r);\n    });\n  }\n  function tipNa(el, tip, W, px, py) {\n    tip.hidden = false;\n    const k = el.clientWidth / W;\n    const w = tip.offsetWidth, h = tip.offsetHeight;\n    let left = px * k + 14;\n    if (left + w > el.clientWidth) left = px * k - w - 14;\n    tip.style.left = `${Math.max(0, left)}px`;\n    tip.style.top = `${Math.max(0, py * k - h / 2)}px`;\n  }\n  function osaX(svg, x, rows, W, yPos) {\n    const roku = (rows[rows.length - 1].date - rows[0].date) / 315576e5;\n    let ticks, f;\n    if (roku > 2.2) { ticks = x.ticks(d3.utcYear); f = cz.utcFormat('%Y'); }\n    else { ticks = x.ticks(d3.utcMonth.every(roku > 1.2 ? 6 : (W < 480 ? 4 : 2))); f = cz.utcFormat('%b %Y'); }\n    const g = svg.append('g');\n    let posledni = -Infinity;\n    ticks.forEach((t) => {\n      const t0 = g.append('text').attr('class', 'pp-tick').attr('text-anchor', 'middle').attr('x', x(t)).attr('y', yPos).text(f(t));\n      const w = t0.node().getComputedTextLength();\n      if (x(t) - w / 2 < 0 || x(t) + w / 2 > W || x(t) - w / 2 < posledni + 8) t0.remove();\n      else posledni = x(t) + w / 2;\n    });\n  }\n\n  dash.draw('graf', (el) => {\n    if (stav(el, 'ceny')) return;\n    const rows = vObdobi(ceny());\n    if (rows.length < 2) return;\n    const barvy = [dash.colors[0], dash.colors[1]];\n    const W = Math.max(280, el.clientWidth || 640);\n    const H = W < 520 ? 270 : 340;\n    const svg = svgFor(el, W, H, 'Týdenní ceny Natural 95 a nafty v Kč za litr');\n    const y = d3.scaleLinear()\n      .domain([d3.min(rows, (d) => Math.min(d.n95, d.naf)), d3.max(rows, (d) => Math.max(d.n95, d.naf))]).nice();\n    const yt = y.ticks(H < 300 ? 4 : 6);\n    const posl = rows[rows.length - 1];\n    const konce = [\n      {v: posl.n95, name: 'Natural 95', c: barvy[0]},\n      {v: posl.naf, name: 'Nafta', c: barvy[1]},\n    ];\n    const m = {\n      top: 26, bottom: 26,\n      left: sirka(svg, 'pp-tick', yt.map((t) => osaFmt.format(t))) + 10,\n      right: Math.max(sirka(svg, 'pp-end-v', konce.map((k) => nf.format(k.v))), sirka(svg, 'pp-end-n', konce.map((k) => k.name))) + 16,\n    };\n    const x = d3.scaleUtc().domain([rows[0].date, posl.date]).range([m.left, W - m.right]);\n    y.range([H - m.bottom, m.top]);\n\n    svg.append('g').selectAll('line').data(yt).join('line').attr('class', 'pp-grid')\n      .attr('x1', m.left).attr('x2', W - m.right).attr('y1', (d) => y(d)).attr('y2', (d) => y(d));\n    svg.append('g').selectAll('text').data(yt).join('text').attr('class', 'pp-tick')\n      .attr('x', m.left - 8).attr('y', (d) => y(d)).attr('dy', '0.32em').attr('text-anchor', 'end').text((d) => osaFmt.format(d));\n    svg.append('line').attr('class', 'pp-axis').attr('x1', m.left).attr('x2', W - m.right).attr('y1', H - m.bottom).attr('y2', H - m.bottom);\n    osaX(svg, x, rows, W, H - 6);\n\n    const ev = udalosti().filter((e) => e.date >= rows[0].date && e.date <= posl.date);\n    const eg = svg.append('g');\n    ev.forEach((e) => {\n      const xx = x(e.date);\n      eg.append('line').attr('class', 'pp-ref').attr('x1', xx).attr('x2', xx).attr('y1', m.top - 4).attr('y2', H - m.bottom);\n      const g = eg.append('g').attr('transform', `translate(${xx},${m.top - 13})`);\n      g.append('circle').attr('class', 'pp-ev-dot').attr('r', 8);\n      g.append('text').attr('class', 'pp-ev-num').attr('text-anchor', 'middle').attr('dy', '0.35em').text(e.n);\n    });\n\n    const cara = (k) => d3.line().x((d) => x(d.date)).y((d) => y(d[k]));\n    svg.append('path').datum(rows).attr('class', 'pp-line').style('stroke', barvy[0]).attr('d', cara('n95'));\n    svg.append('path').datum(rows).attr('class', 'pp-line').style('stroke', barvy[1]).attr('d', cara('naf'));\n\n    const lab = konce.map((k) => ({...k, y: y(k.v)})).sort((a, b) => a.y - b.y);\n    if (lab[1].y - lab[0].y < 32) {\n      const s = (lab[0].y + lab[1].y) / 2;\n      lab[0].y = s - 16;\n      lab[1].y = s + 16;\n    }\n    konce.forEach((k) => svg.append('circle').attr('cx', W - m.right).attr('cy', y(k.v)).attr('r', 3.5).style('fill', k.c));\n    lab.forEach((k) => {\n      const g = svg.append('g').attr('transform', `translate(${W - m.right + 9},${k.y})`);\n      g.append('text').attr('class', 'pp-end-v').style('fill', k.c).attr('dy', '0.1em').text(nf.format(k.v));\n      g.append('text').attr('class', 'pp-end-n').attr('dy', '1.25em').text(k.name);\n    });\n\n    const tip = document.createElement('div');\n    tip.className = 'pp-tip';\n    tip.hidden = true;\n    el.append(tip);\n    const hov = svg.append('g').style('display', 'none');\n    const rule = hov.append('line').attr('class', 'pp-rule').attr('y1', m.top).attr('y2', H - m.bottom);\n    const t1 = hov.append('circle').attr('r', 4).style('fill', barvy[0]);\n    const t2 = hov.append('circle').attr('r', 4).style('fill', barvy[1]);\n    const bis = d3.bisector((d) => d.date).center;\n    svg.append('rect').attr('x', m.left).attr('y', m.top).attr('width', W - m.left - m.right).attr('height', H - m.top - m.bottom)\n      .attr('fill', 'transparent')\n      .on('pointermove', (e) => {\n        const [px] = d3.pointer(e);\n        const d = rows[bis(rows, x.invert(px))];\n        const xx = x(d.date);\n        hov.style('display', null);\n        rule.attr('x1', xx).attr('x2', xx);\n        t1.attr('cx', xx).attr('cy', y(d.n95));\n        t2.attr('cx', xx).attr('cy', y(d.naf));\n        tipPopis(tip, `Týden od ${den(d.tyden)}`, [\n          [barvy[0], 'Natural 95', `${nf.format(d.n95)} Kč`],\n          [barvy[1], 'Nafta', `${nf.format(d.naf)} Kč`],\n        ]);\n        tipNa(el, tip, W, xx, (y(d.n95) + y(d.naf)) / 2);\n      })\n      .on('pointerleave', () => { hov.style('display', 'none'); tip.hidden = true; });\n  });\n\n  dash.draw('udalosti', (ol) => {\n    ol.replaceChildren();\n    udalosti().forEach((e) => {\n      const li = document.createElement('li');\n      const n = document.createElement('span');\n      n.className = 'pp-ev-n';\n      n.textContent = e.n;\n      const t = document.createElement('time');\n      t.dateTime = e.datum;\n      t.textContent = den(e.datum);\n      const s = document.createElement('span');\n      s.textContent = e.text;\n      li.append(n, t, s);\n      ol.append(li);\n    });\n  });\n\n  dash.draw('rozdil', (el) => {\n    if (stav(el, 'rozdil')) return;\n    const rows = vObdobi(dash.data('rozdil').data\n      .map((d) => ({date: new Date(d.tyden), tyden: d.tyden, v: +d.rozdil})).sort((a, b) => a.date - b.date));\n    if (rows.length < 2) return;\n    const barvy = [dash.colors[0], dash.colors[1]];\n    const W = Math.max(260, el.clientWidth || 480);\n    const H = 200;\n    const svg = svgFor(el, W, H, 'Rozdíl ceny nafty a Natural 95 po týdnech');\n    const y = d3.scaleLinear().domain([Math.min(0, d3.min(rows, (d) => d.v)), Math.max(0, d3.max(rows, (d) => d.v))]).nice();\n    const yt = y.ticks(4);\n    const m = {top: 8, right: 6, bottom: 24, left: sirka(svg, 'pp-tick', yt.map((t) => osaZnFmt.format(t))) + 10};\n    const x = d3.scaleUtc().domain([rows[0].date, rows[rows.length - 1].date]).range([m.left, W - m.right]);\n    y.range([H - m.bottom, m.top]);\n\n    svg.append('g').selectAll('line').data(yt).join('line').attr('class', 'pp-grid')\n      .attr('x1', m.left).attr('x2', W - m.right).attr('y1', (d) => y(d)).attr('y2', (d) => y(d));\n    svg.append('g').selectAll('text').data(yt).join('text').attr('class', 'pp-tick')\n      .attr('x', m.left - 8).attr('y', (d) => y(d)).attr('dy', '0.32em').attr('text-anchor', 'end').text((d) => osaZnFmt.format(d));\n    osaX(svg, x, rows, W, H - 4);\n\n    const plocha = (f) => d3.area().x((d) => x(d.date)).y0(y(0)).y1((d) => y(f(d.v)));\n    svg.append('path').datum(rows).style('fill', barvy[1]).attr('fill-opacity', 0.45).attr('d', plocha((v) => Math.max(0, v)));\n    svg.append('path').datum(rows).style('fill', barvy[0]).attr('fill-opacity', 0.45).attr('d', plocha((v) => Math.min(0, v)));\n    svg.append('path').datum(rows).attr('class', 'pp-spread-line').attr('d', d3.line().x((d) => x(d.date)).y((d) => y(d.v)));\n    svg.append('line').attr('class', 'pp-axis').attr('x1', m.left).attr('x2', W - m.right).attr('y1', y(0)).attr('y2', y(0));\n\n    const tip = document.createElement('div');\n    tip.className = 'pp-tip';\n    tip.hidden = true;\n    el.append(tip);\n    const hov = svg.append('g').style('display', 'none');\n    const rule = hov.append('line').attr('class', 'pp-rule').attr('y1', m.top).attr('y2', H - m.bottom);\n    const dot = hov.append('circle').attr('r', 4);\n    const bis = d3.bisector((d) => d.date).center;\n    svg.append('rect').attr('x', m.left).attr('y', m.top).attr('width', W - m.left - m.right).attr('height', H - m.top - m.bottom)\n      .attr('fill', 'transparent')\n      .on('pointermove', (e) => {\n        const [px] = d3.pointer(e);\n        const d = rows[bis(rows, x.invert(px))];\n        const xx = x(d.date);\n        hov.style('display', null);\n        rule.attr('x1', xx).attr('x2', xx);\n        dot.attr('cx', xx).attr('cy', y(d.v)).style('fill', d.v >= 0 ? barvy[1] : barvy[0]);\n        tipPopis(tip, `Týden od ${den(d.tyden)}`, [[null, 'Nafta minus Natural 95', `${sf.format(d.v)} Kč`]]);\n        tipNa(el, tip, W, xx, y(d.v));\n      })\n      .on('pointerleave', () => { hov.style('display', 'none'); tip.hidden = true; });\n  });\n\n  dash.draw('sousede', (el) => {\n    if (stav(el, 'sousede')) return;\n    const rows = dash.data('sousede').data\n      .map((d) => ({zeme: d.zeme, n95: +d.natural95, naf: +d.nafta, n95e: +d.natural95_eur, nafe: +d.nafta_eur}))\n      .sort((a, b) => b.naf - a.naf);\n    if (!rows.length) return;\n    const barvy = [dash.colors[0], dash.colors[1]];\n    const W = Math.max(260, el.clientWidth || 480);\n    const bh = 11, mezera = 3, rad = 16, vyska = bh * 2 + mezera;\n    const H = rows.length * (vyska + rad) - rad + 4;\n    const svg = svgFor(el, W, H, 'Ceny Natural 95 a nafty v Česku a sousedních zemích');\n    const m = {\n      left: sirka(svg, 'pp-cat pp-cat-cz', rows.map((r) => r.zeme)) + 12,\n      right: sirka(svg, 'pp-val', rows.flatMap((r) => [nf.format(r.n95), nf.format(r.naf)])) + 10,\n    };\n    const x = d3.scaleLinear().domain([0, d3.max(rows, (r) => Math.max(r.n95, r.naf))]).range([m.left, W - m.right]);\n    const tip = document.createElement('div');\n    tip.className = 'pp-tip';\n    tip.hidden = true;\n    rows.forEach((r, i) => {\n      const y0 = 2 + i * (vyska + rad);\n      const g = svg.append('g');\n      const cz0 = r.zeme === 'Česko';\n      if (cz0) g.append('rect').attr('class', 'pp-band').attr('x', 0).attr('y', y0 - 5).attr('width', W).attr('height', vyska + 10).attr('rx', 3);\n      g.append('text').attr('class', cz0 ? 'pp-cat pp-cat-cz' : 'pp-cat').attr('x', 0).attr('y', y0 + vyska / 2).attr('dy', '0.35em').text(r.zeme);\n      [[r.n95, 0], [r.naf, 1]].forEach(([v, k], j) => {\n        const yy = y0 + j * (bh + mezera);\n        g.append('rect').attr('x', m.left).attr('y', yy).attr('width', Math.max(0, x(v) - m.left)).attr('height', bh).attr('rx', 2).style('fill', barvy[k]);\n        g.append('text').attr('class', 'pp-val').attr('x', x(v) + 6).attr('y', yy + bh / 2).attr('dy', '0.35em').text(nf.format(v));\n      });\n      g.append('rect').attr('x', 0).attr('y', y0 - rad / 2).attr('width', W).attr('height', vyska + rad).attr('fill', 'transparent')\n        .on('pointermove', (e) => {\n          const [px] = d3.pointer(e, svg.node());\n          tipPopis(tip, r.zeme, [\n            [barvy[0], 'Natural 95', `${nf.format(r.n95)} Kč (${nf.format(r.n95e)} €)`],\n            [barvy[1], 'Nafta', `${nf.format(r.naf)} Kč (${nf.format(r.nafe)} €)`],\n          ]);\n          tipNa(el, tip, W, px, y0 + vyska / 2);\n        })\n        .on('pointerleave', () => { tip.hidden = true; });\n    });\n    el.append(tip);\n  });\n\n  dash.draw('roky', (tb) => {\n    tb.replaceChildren();\n    const g = dash.data('roky');\n    if (g.status !== 'ok') return;\n    [...g.data].sort((a, b) => String(b.rok).localeCompare(String(a.rok))).forEach((r) => {\n      const tr = document.createElement('tr');\n      [r.rok, nf.format(r.natural95_prumer), nf.format(r.natural95_max), nf.format(r.nafta_prumer), nf.format(r.nafta_max), String(r.tydnu)]\n        .forEach((t, i) => {\n          const c = document.createElement(i ? 'td' : 'th');\n          if (!i) c.scope = 'row';\n          c.textContent = t;\n          tr.append(c);\n        });\n      tb.append(tr);\n    });\n  });\n\n  dash.draw('nadrz', (tb) => {\n    tb.replaceChildren();\n    const r = radek('souhrn');\n    if (!r) return;\n    const inp = document.getElementById('pp-litry');\n    const litru = Math.min(200, Math.max(0, inp ? +inp.value || 0 : 50));\n    [['Natural 95', r.natural95, r.natural95_rok, 0], ['Nafta', r.nafta, r.nafta_rok, 1]].forEach(([nazev, ted, loni, k]) => {\n      const tr = document.createElement('tr');\n      const th = document.createElement('th');\n      th.scope = 'row';\n      const sw = document.createElement('span');\n      sw.className = 'pp-sw';\n      sw.style.background = dash.colors[k];\n      th.append(sw, nazev);\n      const a = ted * litru, b = loni * litru, d = Math.round(a) - Math.round(b);\n      const bunky = [`${kc.format(a)} Kč`, `${kc.format(b)} Kč`, `${skc.format(d)} Kč`].map((t, j) => {\n        const td = document.createElement('td');\n        td.textContent = t;\n        if (j === 2) td.className = d > 0 ? 'pp-up' : d < 0 ? 'pp-down' : '';\n        return td;\n      });\n      tr.append(th, ...bunky);\n      tb.append(tr);\n    });\n  });\n})();\n</script>\n"}